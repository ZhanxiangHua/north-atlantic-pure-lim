#!/usr/bin/env bash
#PBS -N lim_native_weather
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=5GB
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/weather_controls.py --tag "$MODEL_TAG" --weights "$MODEL_WEIGHTS" --role "${EVAL_ROLE:-val}"
