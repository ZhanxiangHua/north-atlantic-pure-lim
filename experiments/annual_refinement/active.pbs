#!/usr/bin/env bash
#PBS -N lim_active_warming
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=8GB
#PBS -l walltime=01:30:00
#PBS -J 1-12%3
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=3
source experiments/annual_refinement/env.sh
args=()
if [[ -n "${ACTIVE_EXPORT:-}" ]]; then args+=(--export "$ACTIVE_EXPORT"); fi
exec "$TC_PYTHON" -u experiments/annual_refinement/active_warming.py --tag "$MODEL_TAG" --month "$PBS_ARRAY_INDEX" "${args[@]}" > "$TC_REFINEMENT_WORK/logs/active-$MODEL_TAG-${ACTIVE_EXPORT:-screen}-$PBS_ARRAY_INDEX.log" 2>&1
