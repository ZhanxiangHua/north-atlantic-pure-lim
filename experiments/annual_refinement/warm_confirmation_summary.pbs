#!/usr/bin/env bash
#PBS -N lim_new_warm_sum
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=5GB
#PBS -l walltime=00:20:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/warm_confirmation.py --summary "$PWD/reports/annual_refinement/data" > "$TC_REFINEMENT_WORK/logs/new-warm-summary.log" 2>&1
