#!/usr/bin/env bash
#PBS -N lim_visible_gain
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=8GB
#PBS -l walltime=00:30:00
#PBS -J 1-12%4
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/wind_visible_gain.py --month "$PBS_ARRAY_INDEX" > "$TC_REFINEMENT_WORK/logs/wind-visible-gain-$PBS_ARRAY_INDEX.log" 2>&1
