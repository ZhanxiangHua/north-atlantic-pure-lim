#!/usr/bin/env bash
#PBS -N lim_front_ocean
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=12GB
#PBS -l walltime=00:40:00
#PBS -J 1-12%4
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=3
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/ocean_fronts.py --month "$PBS_ARRAY_INDEX" > "$TC_REFINEMENT_WORK/logs/ocean-fronts-$PBS_ARRAY_INDEX.log" 2>&1
