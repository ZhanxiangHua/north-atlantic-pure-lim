#!/usr/bin/env bash
#PBS -N lim_visible_score
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=8GB
#PBS -l walltime=00:35:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=3
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/wind_visible_gain.py --summary "$PWD/reports/annual_refinement/data" > "$TC_REFINEMENT_WORK/logs/wind-visible-gain-summary.log" 2>&1
