#!/usr/bin/env bash
#PBS -N lim_shear_targets
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=12GB
#PBS -l walltime=01:00:00
#PBS -J 1-12%3
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
rd="$TC_REFINEMENT_WORK"
exec "$TC_PYTHON" -u experiments/annual_refinement/regional_wind.py --cohort "${COHORT:-original}" --month "${PBS_ARRAY_INDEX:?}" > "$rd/logs/regional-${COHORT:-original}-$PBS_ARRAY_INDEX.log" 2>&1
