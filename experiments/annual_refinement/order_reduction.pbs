#!/usr/bin/env bash
#PBS -N lim_order_memory
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=12GB
#PBS -l walltime=00:30:00
#PBS -J 1-12%4
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/order_reduction.py --month "$PBS_ARRAY_INDEX" > "$TC_REFINEMENT_WORK/logs/order-reduction-$PBS_ARRAY_INDEX.log" 2>&1
