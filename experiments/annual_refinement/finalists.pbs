set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/finalists.py --tag "$MODEL_TAG" --account "${PBS_ACCOUNT:-UWAS0120}" --schedule
