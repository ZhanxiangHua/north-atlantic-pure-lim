#!/usr/bin/env bash
#PBS -N lim_seasonal_wind
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=6GB
#PBS -l walltime=00:50:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
rd="$TC_REFINEMENT_WORK"
args=()
if [[ -n "${SEASONAL_EXPORT:-}" ]]; then args+=(--export "$SEASONAL_EXPORT"); fi
exec "$TC_PYTHON" -u experiments/annual_refinement/seasonal.py --tag "${MODEL_TAG:?}" --weights "${MODEL_WEIGHTS:-$PWD/runs/annual_lim/weights}" --cohort "${COHORT:-original}" "${args[@]}" > "$rd/logs/seasonal-$MODEL_TAG-${SEASONAL_EXPORT:-screen}.log" 2>&1
