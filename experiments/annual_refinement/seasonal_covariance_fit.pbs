#!/usr/bin/env bash
#PBS -N lim_seasonal_fit
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=4GB
#PBS -l walltime=00:35:00
#PBS -J 0-3
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/seasonal_covariance_cv.py fit --lane "$PBS_ARRAY_INDEX" > "$TC_REFINEMENT_WORK/logs/seasonal-covariance-fit-$PBS_ARRAY_INDEX.log" 2>&1
