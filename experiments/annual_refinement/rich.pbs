#!/usr/bin/env bash
#PBS -N lim_rich_ocean
#PBS -q casper
#PBS -l select=1:ncpus=5:mem=9GB
#PBS -l walltime=01:00:00
#PBS -J 1-12%3
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=4
source experiments/annual_refinement/env.sh
rd="$TC_REFINEMENT_WORK"
exec "$TC_PYTHON" -u experiments/annual_refinement/ocean_rich.py --month "${PBS_ARRAY_INDEX:?}" > "$rd/logs/rich-bases-${PBS_ARRAY_INDEX}.log" 2>&1
