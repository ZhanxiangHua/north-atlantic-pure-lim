#!/usr/bin/env bash
#PBS -N lim_ocean_moreyrs
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=8GB
#PBS -l walltime=04:00:00
#PBS -J 0-11%4
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source experiments/annual_refinement/env.sh
rd="$TC_REFINEMENT_WORK"
exec "$TC_PYTHON" -u experiments/annual_refinement/ocean_only.py --shard "${PBS_ARRAY_INDEX:?}" > "$rd/logs/ocean-extra-${PBS_ARRAY_INDEX}.log" 2>&1
