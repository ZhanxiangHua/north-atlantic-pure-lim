#!/usr/bin/env bash
#PBS -N lim_residual_ocean
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=6GB
#PBS -l walltime=00:45:00
#PBS -J 1-12%4
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=3
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/ocean_residual.py --tag "${MODEL_TAG:?}" \
  --weights "${MODEL_WEIGHTS:?}" --cohort "${COHORT:?}" --month "$PBS_ARRAY_INDEX" \
  > "$TC_REFINEMENT_WORK/logs/residual-ocean-$MODEL_TAG-$PBS_ARRAY_INDEX.log" 2>&1
