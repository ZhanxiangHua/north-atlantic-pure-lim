#!/usr/bin/env bash
#PBS -N lim_paired_ci
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=5GB
#PBS -l walltime=00:45:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=3
source experiments/annual_refinement/env.sh
rd="$TC_REFINEMENT_WORK"
role="${EVAL_ROLE:-val}"
args=(--candidate "${MODEL_TAG:?}" --role "$role" --draws "${BOOT_DRAWS:-2000}")
exec > "$rd/logs/intervals-$MODEL_TAG-$role.log" 2>&1
"$TC_PYTHON" -u experiments/annual_refinement/paired_intervals.py "${args[@]}"
if [[ "$role" == "fresh" ]]; then
    "$TC_PYTHON" -u experiments/annual_refinement/paired_intervals.py "${args[@]}" --exclude-september
fi
