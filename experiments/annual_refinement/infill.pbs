#!/usr/bin/env bash
#PBS -N lim_full_wind_years
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=9GB
#PBS -l walltime=04:00:00
#PBS -J 0-15%8
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source experiments/annual_refinement/env.sh
rd="$TC_REFINEMENT_WORK"
exec "$TC_PYTHON" -u -m annual_lim --config "$rd/configs/wind_infill" --work "$rd/infill" prepare --shard "${PBS_ARRAY_INDEX:?}" --shards 16 --workers 2 > "$rd/logs/infill-$PBS_ARRAY_INDEX.log" 2>&1
