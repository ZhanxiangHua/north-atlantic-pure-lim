#!/usr/bin/env bash
#PBS -N lim_ocean_eof
#PBS -q casper
#PBS -l select=1:ncpus=3:mem=9GB
#PBS -l walltime=01:00:00
#PBS -J 1-12%4
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=2
source experiments/annual_refinement/env.sh
run_dir="$TC_REFINEMENT_WORK"
cohort="${COHORT:-original}"
month="${PBS_ARRAY_INDEX:?}"
exec > "$run_dir/logs/ocean-${cohort}-${month}.log" 2>&1
"$TC_PYTHON" -u experiments/annual_refinement/ocean.py --cohort "$cohort" --month "$month"
"$TC_PYTHON" -u experiments/annual_refinement/ocean.py --cohort "$cohort" --month "$month" --extended
