#!/usr/bin/env bash
#PBS -N tc_mid_data
#PBS -q casper
#PBS -l select=1:ncpus=1:mem=6GB
#PBS -l walltime=02:00:00
#PBS -J 0-47%12
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source experiments/annual_refinement/env.sh
exec "$TC_PYTHON" -u experiments/annual_refinement/midcentury_prepare.py prepare --index "${PBS_ARRAY_INDEX:?}" --mirror "${CMIP6_MIRROR:-/glade/collections/cmip/CMIP6}"
