#!/usr/bin/env bash
#PBS -N lim_nested_ocean
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=6GB
#PBS -l walltime=00:45:00
#PBS -J 1-12%3
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
export TC_BLAS_THREADS=3
source experiments/annual_refinement/env.sh
rd="$TC_REFINEMENT_WORK"
cohort="${COHORT:-original}"
exec "$TC_PYTHON" -u experiments/annual_refinement/nested.py --cohort "$cohort" --month "${PBS_ARRAY_INDEX:?}" > "$rd/logs/nested-$cohort-$PBS_ARRAY_INDEX.log" 2>&1
