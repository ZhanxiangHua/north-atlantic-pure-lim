#!/usr/bin/env bash
#PBS -N tc_annual_fit
#PBS -q casper
#PBS -J 1-12
#PBS -l select=1:ncpus=5:mem=16GB
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
py="${ANNUAL_PYTHON:-python}"
work="${ANNUAL_WORK:-work}"
export OPENBLAS_NUM_THREADS=4
export OMP_NUM_THREADS="$OPENBLAS_NUM_THREADS"
export MKL_NUM_THREADS="$OPENBLAS_NUM_THREADS"
exec "$py" -u run.py --work "$work" train --month "${PBS_ARRAY_INDEX:?}"
